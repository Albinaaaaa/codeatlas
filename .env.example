APP_NAME=CodeAtlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=codeatlas
DB_USERNAME=codeatlas
DB_PASSWORD=codeatlas

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

OLLAMA_URL=http://127.0.0.1:11434

# Trusted development/self-hosted feature. Disable this for SaaS deployments.
CODEATLAS_LOCAL_SOURCE_ENABLED=true

# Docker host workspace. Set this in .env before starting the development
# Compose stack; platform-specific examples are documented in README.md.
CODEATLAS_LOCAL_REPOS_PATH=

# Fixed path visible to the CodeAtlas runtime. Docker Compose mounts the host
# workspace above here as read-only. Native self-hosted installs may set this to
# their own absolute, read-only repository workspace.
CODEATLAS_LOCAL_SOURCE_ROOT=/codeatlas/sources
CODEATLAS_DOCKER_APP_URL=http://localhost:8080

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VITE_HMR_HOST=localhost
